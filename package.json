{
  "name": "sive",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint . --ignore-pattern '**/*.test.*'",
    "lint:fix": "prettier --write . && eslint . --fix --ignore-pattern '**/*.test.*'",
    "format": "prettier --write .",
    "test:unit": "vitest --exclude 'src/lib/elements/SummaryPanel.svelte.spec.ts' ",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.8",
    "@vitest/browser-playwright": "^4.1.11",
    "better-auth": "^1.7.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "js-yaml": "^4.3.2",
    "mdsvex": "^0.12.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "kysely": ">=0.28.14",
      "picomatch": ">=4.0.4",
      "defu": ">=6.1.5",
      "esbuild@<=0.24.2": ">=0.25.0",
      "cookie@<0.7.0": ">=0.7.0",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "yaml@>=1.0.0 <1.10.3": ">=1.10.3",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "@medyll/css-base": "^0.1.22",
    "better-sqlite3": "^12.11.1",
    "nanoid": "^5.1.16",
    "openai": "^6.49.0"
  }
}
